# Bitget API 인증 정보
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_PASSPHRASE=your_passphrase_here

# 실행 모드: True=가상 모의 매매(DRY-RUN), False=실계좌 실거래
DRY_RUN=True

# 퀀트 전략 모드: DONCHIAN_4H (3년 실데이터 검증 거시추세 전략, 추천) | SCALPING_5M (5분봉 스캘핑)
STRATEGY_MODE=DONCHIAN_4H

# 거래 대상 심볼 (BTC/USDT:USDT, SOL/USDT:USDT 등)
SYMBOL=BTC/USDT:USDT

# 캔들 타임프레임 (검증된 거시추세 전략 권장: 4h)
TIMEFRAME=4h

# 레버리지 배율 (수학적 최적 스윗스팟: 2x)
LEVERAGE=2

# 포지션 배분 비중 (0.50 = 계좌의 50% 배분)
PORTFOLIO_ALLOCATION=0.50

# 일일 최대 누적 손실률 허용치 (-0.05 = -5% 도달 시 당일 거래 강제 종료)
DAILY_MAX_LOSS_RATIO=-0.05

# 🛡️ 가짜 돌파 방어 및 본전 이익보존(Break-Even) 보완 옵션
USE_BREAK_EVEN=True
BREAK_EVEN_TRIGGER_RATIO=0.020    # +2.0% 수익 도달 시 본전(+0.2%)으로 스탑 자동 이동 (손실 방어)
USE_VOLUME_FILTER=True           # 거래량 미달 가짜 돌파 필터링
VOLUME_FILTER_RATIO=0.80         # 직전 20봉 평균 거래량 대비 80% 이상
MAX_RSI_ENTRY=78.0               # RSI 78 초과 과열권 꼭대기 추격 매수 금지
MIN_ADX_ENTRY=18.0               # ADX 18 미만 무추세 횡보장 휩소 금지

# [선택] 텔레그램 스마트폰 실시간 알림 (클라우드 24/7 원격 감시용)
# BotFather에서 생성한 토큰과 @userinfobot 등에서 확인한 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

